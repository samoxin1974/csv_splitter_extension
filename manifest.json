{
  "manifest_version": 3,
  "name": "CSV Splitter",
  "version": "1.0",
  "description": "Splits a CSV file into multiple smaller CSV files bundled in a ZIP archive.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}